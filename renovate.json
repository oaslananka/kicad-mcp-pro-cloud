{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 1-6 * * 1"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 2,
  "automerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "prConcurrentLimit": 3
  },
  "packageRules": [
    {
      "description": "Group routine non-major npm upgrades to reduce PR and CI volume",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "groupName": "npm minor and patch updates"
    },
    {
      "description": "Keep Better Auth core and extensions together for compatibility",
      "matchPackageNames": ["better-auth", "@better-auth/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Better Auth non-major updates"
    },
    {
      "description": "Group non-major GitHub Actions upgrades without combining majors",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major updates"
    }
  ]
}
