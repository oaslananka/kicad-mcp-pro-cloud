# Public HTTPS origin (no trailing slash) of this Cloud MCP resource server
PUBLIC_ORIGIN=https://kicad-mcp-pro.oaslananka.dev
# Bind loopback by default. A public binding requires TLS termination in front.
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://REPLACE_WITH_LOCAL_DEVELOPMENT_DATABASE
# OAuth 2.1 Authorization Server (not built into this service)
OAUTH_ISSUER=https://identity.example.invalid
OAUTH_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
OAUTH_AUDIENCE=https://kicad-mcp-pro.oaslananka.dev/mcp
# Optional exact additional browser origins. No wildcards.
ALLOWED_ORIGINS=
